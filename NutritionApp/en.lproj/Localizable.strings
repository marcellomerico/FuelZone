"methodology.ref.oxidation.citation" = "Oxidation of carbohydrate feedings during prolonged exercise. Sports Medicine.";
"methodology.ref.mtc.title" = "Jeukendrup – GSSI SSE-108";
"methodology.ref.mtc.citation" = "Multiple transportable carbohydrates and their benefits.";
"methodology.ref.issn.title" = "ISSN (2017)";
"methodology.ref.issn.citation" = "Position stand: nutrient timing.";
"methodology.disclaimer" = "This information is for educational purposes. Individual tolerance, gut training, and medical conditions vary. Consult a sports dietitian or physician for personalized advice.";

