/* Methodology */
"methodology.title" = "Science & methodology";
"methodology.hero.subtitle" = "Here is how FuelZone builds your plan — explained clearly, with the research behind it.";
"methodology.why.title" = "Why grams per hour?";
"methodology.why.body" = "During exercise, your gut can only absorb a limited amount of carbohydrate per hour. That limit is similar for most people, which is why sports scientists recommend fixed hourly amounts (such as 30, 60, or 90 grams) instead of calculating from body weight.";
"methodology.how.title" = "How your plan is built";
"methodology.how.subtitle" = "Four simple steps in the app.";
"methodology.step1.title" = "Session length";
"methodology.step1.body" = "Longer sessions need more carbs per hour. Under 30 minutes we only show a light hint.";
"methodology.step2.title" = "Planned intensity";
"methodology.step2.body" = "Easy efforts or lots of time in low heart-rate zones lower the target. Hard sessions keep the full recommendation.";
"methodology.step3.title" = "Your stomach";
"methodology.step3.body" = "If you chose a sensitive stomach in onboarding, we cap hourly carbs so the plan stays realistic.";
"methodology.step4.title" = "A small range";
"methodology.step4.body" = "You see a band around the value (about ±8%%) because tolerance varies from day to day.";
"methodology.tiers.title" = "Carb targets by duration";
"methodology.tiers.subtitle" = "Based on Jeukendrup (2014) and Burke et al. (2011).";
"methodology.tier.short.duration" = "30–75 minutes";
"methodology.tier.short.amount" = "~30 g/h";
"methodology.tier.short.tip" = "Often one gel or drink is enough. A full timeline is optional.";
"methodology.tier.medium.duration" = "75 min – 2.5 hours";
"methodology.tier.medium.amount" = "~60 g/h";
"methodology.tier.medium.tip" = "Gels, sports drinks, or bars with glucose or maltodextrin work well.";
"methodology.tier.long.duration" = "Over 2.5 hours";
"methodology.tier.long.amount" = "~90 g/h";
"methodology.tier.long.tip" = "Use a mix of glucose and fructose (about 2:1) so your gut can absorb more.";
"methodology.adjustments.title" = "What else we adjust";
"methodology.adjustment.intensity.body" = "Heart-rate zones: more minutes in easy zones → slightly lower carb target.";
"methodology.adjustment.stomach.body" = "Stomach sensitivity: conservative caps intake at about 77 g/h. Tolerant allows up to about 100 g/h in sessions of 2.5 h or more – only with a trained gut and glucose–fructose products.";
"methodology.fluids.title" = "Fluids & sodium";
"methodology.fluids.body" = "These use your sweat profile, temperature, and weather — separate from the carbohydrate research above.";
"methodology.sources.title" = "Scientific sources";
"methodology.sources.subtitle" = "Tap to open the original publications.";
"methodology.sources.open" = "Open publication";
"methodology.ref.jeukendrup.title" = "Jeukendrup (2014)";
"methodology.ref.jeukendrup.citation" = "A Step Towards Personalized Sports Nutrition: Carbohydrate Intake During Exercise. Sports Medicine.";
"methodology.ref.burke.title" = "Burke et al. (2011)";
"methodology.ref.burke.citation" = "Carbohydrates for training and competition. Journal of Sports Sciences.";
